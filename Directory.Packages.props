<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Azure SDK">
    <PackageVersion Include="Azure.Data.Tables" Version="12.9.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.22.2" />
    <PackageVersion Include="Azure.Identity" Version="1.13.1" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.18.2" />
    <PackageVersion Include="Microsoft.Azure.Batch" Version="16.3.1" />
  </ItemGroup>

  <ItemGroup Label="Azure Functions — .NET 10 isolated worker">
    <!-- Worker 2.52.0 satisfies the >= 2.1.0 requirement from Extensions.Http.AspNetCore 2.1.0 -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <!-- SDK 2.0.7 is the first version that added net10-isolated support -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.7" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.0.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.ServiceBus" Version="5.7.0" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core / General">
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.6.0" />
    <PackageVersion Include="Cronos" Version="0.8.4" />
  </ItemGroup>
</Project>
